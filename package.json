{
  "name": "@anseta/mcp",
  "version": "0.2.0",
  "description": "MCP server exposing the Anseta staking API as 12 curated tools",
  "scripts": {
    "test": "vitest run",
    "capture:fixtures": "tsx scripts/capture-fixtures.ts",
    "build": "tsup src/stdio.ts src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run test && pnpm run build",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "mcp",
    "staking",
    "anseta",
    "blockchain"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "anseta-mcp": "./dist/stdio.js"
  },
  "dependencies": {
    "@anseta/typescript-sdk": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.3.0",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anseta-labs/mcp.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
